# Copy to `.env` on the VPS (never commit the real file — it's already in
# .gitignore) and fill in real values. docker-compose.yml reads these.

# --- Postgres ---
POSTGRES_USER=aisha
POSTGRES_PASSWORD=
POSTGRES_DB=aisha_production

# --- Backend ---
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAKE_BLOG_SECRET=

# --- Frontend build args (public site) ---
# Same EmailJS project as the backend's EMAILJS_* above — this is the
# public key half, meant to ship in client JS.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
