# Copy to `.env.staging` on the VPS (never commit the real file — see
# .gitignore) and fill in real values. docker-compose.staging.yml reads
# these. Use DIFFERENT secrets from .env.production wherever practical
# (POSTGRES_PASSWORD, JWT_SECRET, PAYOUT_ENCRYPTION_KEY, PayPal sandbox
# credentials) — staging should never be able to decrypt/sign anything
# production created, or vice versa.

# --- Postgres (separate DB from production) ---
POSTGRES_USER=aisha
POSTGRES_PASSWORD=
POSTGRES_DB=aisha_staging

# --- Backend ---
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAKE_BLOG_SECRET=
FIREBASE_KEY=
REGISTRATION_EMAIL_TO=

# --- Finance & Payroll module ---
# openssl rand -base64 32 — required before any payout-account endpoint
# (including the demo-data generator) will work; see lib/crypto.js.
PAYOUT_ENCRYPTION_KEY=
# Use PayPal's SANDBOX app credentials here, never live ones.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
